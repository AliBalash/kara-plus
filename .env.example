APP_NAME="Kara Plus"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# The browser never receives this URL or token. Ajil keeps provider keys in ajil/.env.
KARA_AI_ENABLED=false
KARA_AI_DASHBOARD_BRIEF_ENABLED=true
KARA_AI_CONTRACT_BRIEF_ENABLED=true
KARA_AI_PAYMENT_BRIEF_ENABLED=true
KARA_AI_CHANGES_ENABLED=true
AJIL_BASE_URL=http://ajil:8080
AJIL_API_TOKEN=replace_with_a_long_random_client_token
KARA_AI_TIMEOUT=20
KARA_AI_CONNECT_TIMEOUT=3
KARA_AI_CACHE_TTL=600
KARA_AI_MAX_FACTS=25
KARA_AI_MAX_CONTEXT_BYTES=12000
KARA_AI_FAILURE_THRESHOLD=3
KARA_AI_CIRCUIT_COOLDOWN=60
# Use parallel_race only after validating the extra provider cost/latency tradeoff.
KARA_AI_ROUTING_STRATEGY=fallback_chain
KARA_AI_ROUTING_MODE=latency_first
KARA_AI_GROQ_MODEL=llama-3.3-70b-versatile
KARA_AI_GEMINI_MODEL=gemini-2.5-flash
